# GitLab CE on VM-GIT — copy to .env and fill in. Do NOT commit .env.

## Identity ---------------------------------------------------------------
# Internal FQDN of the Git VM. This must be resolvable from VM-COLLECTOR and
# from every workstation that will clone. Changing it later requires a
# reconfigure and invalidates every clone URL already handed out — set it
# correctly the first time.
GITLAB_FQDN=gitlab.internal.example.com

# Pin the version. 'latest' means an unattended `docker compose pull` can jump
# a major release and run an irreversible migration.
#
# 19.2.6 is the latest patch of the previous minor (verified on Docker Hub,
# 2026-09-10). 19.3.2 is the newest release but shipped the same day; for a
# server that has to just sit there and work, one mature minor back is the
# better trade. See README.md §7 before changing this.
GITLAB_VERSION=19.2.6-ce.0

TZ=America/Argentina/Buenos_Aires

## Network ----------------------------------------------------------------
# Private VNet address of this VM. Leave unset only for an initial bring-up.
BIND_ADDR=10.0.2.4

# Host ports. This VM already runs NetBox on 80/443, so GitLab takes
# non-standard ones. GITLAB_HTTPS_PORT is also written into external_url, which
# means it is baked into every clone URL GitLab hands out — changing it later
# requires a reconfigure and breaks existing remotes. Decide it now.
GITLAB_HTTPS_PORT=8443
GITLAB_HTTP_PORT=8480

# git+ssh port. The host sshd owns 22 — do not move it to free the port up;
# a mistake there locks you out of the VM.
GITLAB_SSH_PORT=2222

## Storage ----------------------------------------------------------------
# MUST be on an attached Azure managed data disk. Never /mnt (ephemeral) and
# never the OS disk (too small). See README.md §1.
GITLAB_DATA_ROOT=/srv/gitlab
GITLAB_BACKUP_ROOT=/srv/gitlab/backups
GITLAB_SSL_DIR=/srv/gitlab/ssl

## Sizing -----------------------------------------------------------------
# Values below suit 4 vCPU / 8 GB (the size GitLab CE actually wants).
# For 2 vCPU / 4 GB use PUMA_WORKERS=0 (single-mode), SIDEKIQ_CONCURRENCY=5,
# PG_SHARED_BUFFERS=128MB — and add swap, see README.md §1.
PUMA_WORKERS=2
SIDEKIQ_CONCURRENCY=10
PG_SHARED_BUFFERS=256MB

## Backups ----------------------------------------------------------------
# Retention for repository backups, in seconds. 604800 = 7 days.
BACKUP_KEEP_SECONDS=604800
