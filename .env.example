# Connection settings for the viewer database. Copy to .env and fill in.
#
#   cp .env.example .env && chmod 600 .env
#
# .env is gitignored. Never commit it: it holds a password.
#
# These are the standard libpq variable names, so anything else that speaks
# Postgres (psql, pg_dump) picks them up from the environment too.

# --- Where the database is -------------------------------------------------
# Private IP or internal FQDN of the database VM, reachable from this host.
PGHOST=10.0.0.0
PGPORT=5432

# Database name on that server.
PGDATABASE=netcollector

# --- Who connects ----------------------------------------------------------
# The read-only role. See docs/ARCHITECTURE.md §9: this account needs SELECT on
# devices and raw_outputs, and nothing else.
PGUSER=extractor_ro
PGPASSWORD=

# --- Transport -------------------------------------------------------------
# The database is on a different VM, so this traffic crosses the network. Without
# sslmode the connection can silently fall back to cleartext, sending the
# password and every configuration it returns in the clear.
#
#   require     encrypt, but do not verify the server's identity
#   verify-full encrypt and verify it -- needs PGSSLROOTCERT below
PGSSLMODE=require
# PGSSLROOTCERT=/etc/ssl/certs/db-ca.pem

# --- Redaction key ---------------------------------------------------------
# Not a database setting, but read from here for convenience. Generate with:
#   openssl rand -hex 32
# Keep a backup: losing it changes every redaction token at once.
NETCONFIG_MIRROR_HMAC_KEY=
